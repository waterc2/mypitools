+
+/** Notification for a goal created paused (pauseOnCreate): persisted, not running. */
+export function buildGoalPausedNotification(args: { objective: string; sisyphus: boolean }): string {
+	const icon = args.sisyphus ? "◆" : "●";
+	const mode = args.sisyphus ? "Sisyphus" : "Goal";
+	const title = truncateText(displayObjectiveTitle(args.objective), 92);
+	return [`${icon} ${mode} created and paused`, `├─ ⟡ ${title}`, "└─ Switch to your execution model, then run /goal-resume to start"].join("\n");
+}
